# Created by: node scripts/setup-verifier.js
# (Firebase settings are in shared/firebaseConfig.js, not here.)
# Verifier server secrets. NEVER put these in Git or share them.
VERIFIER_PRIVATE_KEY=
ID_SALT=

# Pinata (photo storage on IPFS): app.pinata.cloud > API Keys > New Key > JWT
PINATA_JWT=

# Chat storage (Firestore): path to the service-account JSON from Firebase (see README 3c)
FIREBASE_SERVICE_ACCOUNT_FILE=./service-account.json
